# === BACKEND ENVIRONMENT VARIABLES (.env à la racine) ===

# OpenRouter API Key (for AI product analysis)
OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY_HERE

# JWT Secret
JWT_SECRET=oli_strong_secret_change_me

# Database
DATABASE_URL=postgresql://user:password@host:port/database
DB_HOST=your-db-host
DB_PORT=5432
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=oli_db

# Cloudinary (Image Upload)
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Stripe (Payments)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLIC_KEY=pk_live_...

# Firebase (Push Notifications)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY=your-private-key
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# Google Cloud Vision (Image Recognition)
GOOGLE_CLOUD_KEY=path/to/key.json

# Unipesa (Mobile Money)
UNIPESA_API_KEY=your_unipesa_key
UNIPESA_SANDBOX=true

# AWS/Wasabi (S3 Backup Storage)
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET=your_bucket_name
S3_ENDPOINT=https://s3.wasabisys.com
S3_REGION=us-east-1

# App URLs
BASE_URL=https://oli-core.onrender.com
FRONTEND_URL=https://oli-app.firebaseapp.com
SELLER_DASHBOARD_URL=https://oli-seller.vercel.app
ADMIN_DASHBOARD_URL=https://oli-admin-smoky.vercel.app

# CORS Allowed Origins
ALLOWED_ORIGINS=https://oli-core.web.app,https://oli-app.firebaseapp.com,https://olidelivery.web.app,https://oli-admin-smoky.vercel.app,https://oli-seller.vercel.app,http://localhost:3000

# Environment
NODE_ENV=production

# === FRONTEND ENVIRONMENT VARIABLES (oli_seller/.env.local) ===

# OpenRouter API Key (for AI import)
VITE_OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY_HERE

# Backend API URL
VITE_API_URL=https://oli-core.onrender.com
